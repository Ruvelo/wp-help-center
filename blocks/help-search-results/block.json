{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "ruvelo/help-search-results",
    "title": "Help search results",
    "category": "ruvelo-help-center",
    "icon": "search",
    "description": "Results for the current help search, with the matching words highlighted.",
    "keywords": [
        "help",
        "search",
        "results"
    ],
    "textdomain": "ruvelo-help-center",
    "attributes": {
        "perPage": {
            "type": "integer",
            "default": 20
        }
    },
    "supports": {
        "html": false
    },
    "editorScript": "ruvelo-help-center-editor",
    "viewScript": "ruvelo-help-center",
    "style": "ruvelo-help-center"
}
