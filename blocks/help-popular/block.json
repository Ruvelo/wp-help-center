{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "ruvelo/help-popular",
    "title": "Popular help articles",
    "category": "ruvelo-help-center",
    "icon": "star-filled",
    "description": "The articles people read most.",
    "keywords": [
        "help",
        "popular",
        "articles"
    ],
    "textdomain": "ruvelo-help-center",
    "attributes": {
        "heading": {
            "type": "string",
            "default": ""
        },
        "count": {
            "type": "integer",
            "default": 0
        }
    },
    "supports": {
        "align": [
            "wide",
            "full"
        ],
        "html": false
    },
    "editorScript": "ruvelo-help-center-editor",
    "style": "ruvelo-help-center"
}
