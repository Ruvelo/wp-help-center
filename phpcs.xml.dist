<?xml version="1.0"?>
<ruleset name="Ruvelo Help Center">
    <description>WordPress security, database, i18n and PHP rules. Formatting is Pint's job (PSR-12).</description>

    <file>ruvelo-help-center.php</file>
    <file>uninstall.php</file>
    <file>src</file>
    <file>templates</file>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <config name="minimum_wp_version" value="7.0"/>
    <config name="testVersion" value="8.2-"/>

    <rule ref="WordPress.Security"/>
    <rule ref="WordPress.DB"/>
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="ruvelo-help-center"/>
            </property>
        </properties>
    </rule>
    <rule ref="WordPress.WP.AlternativeFunctions"/>
    <rule ref="WordPress.WP.DeprecatedFunctions"/>
    <rule ref="WordPress.WP.DiscouragedFunctions"/>
    <rule ref="WordPress.WP.GlobalVariablesOverride"/>
    <rule ref="WordPress.PHP">
        <!-- Yoda conditions are a style choice; PSR-12 code here doesn't use them. -->
        <exclude name="WordPress.PHP.YodaConditions"/>
        <!-- Deprecated in WPCS 3.3. -->
        <exclude name="WordPress.PHP.POSIXFunctions"/>
    </rule>
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="ruvelo"/>
                <element value="Ruvelo\WP\HelpCenter"/>
            </property>
        </properties>
    </rule>
    <rule ref="WordPress.NamingConventions.ValidHookName"/>
</ruleset>
