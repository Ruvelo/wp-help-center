{
    "preset": "psr12",
    "exclude": [
        ".wp",
        "vendor",
        "build",
        "node_modules"
    ],
    "notPath": [
        "templates/classic.php",
        "demo/halyard/seed.php"
    ],
    "rules": {
        "declare_strict_types": true,
        "concat_space": {
            "spacing": "none"
        },
        "not_operator_with_successor_space": true,
        "ordered_imports": {
            "sort_algorithm": "alpha"
        },
        "no_unused_imports": true,
        "trailing_comma_in_multiline": {
            "elements": [
                "arrays",
                "arguments",
                "parameters"
            ]
        },
        "single_quote": true,
        "array_syntax": {
            "syntax": "short"
        }
    }
}
