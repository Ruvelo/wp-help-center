{
    "$schema": "https://playground.wordpress.net/blueprint-schema.json",
    "meta": {
        "title": "Ruvelo Help Center: the Halyard demo",
        "description": "A help center for Halyard, a fictional B2B billing app: 20 articles in 6 categories, with views, votes and reader comments.",
        "author": "Ruvelo",
        "categories": ["Content", "Support"]
    },
    "landingPage": "/help/",
    "preferredVersions": {
        "php": "8.3",
        "wp": "7.1"
    },
    "features": {
        "networking": true
    },
    "login": true,
    "steps": [
        {
            "step": "installPlugin",
            "pluginData": {
                "resource": "url",
                "url": "https://github.com/Ruvelo/wp-help-center/releases/latest/download/ruvelo-help-center.zip"
            },
            "options": {
                "activate": true
            }
        },
        {
            "step": "setSiteOptions",
            "options": {
                "blogname": "Halyard",
                "permalink_structure": "/%postname%/"
            }
        },
        {
            "step": "writeFiles",
            "writeToPath": "/wordpress/wp-content/halyard",
            "filesTree": {
                "resource": "git:directory",
                "url": "https://github.com/Ruvelo/wp-help-center",
                "ref": "main",
                "path": "demo/halyard"
            }
        },
        {
            "step": "wp-cli",
            "command": "wp help-center import /wordpress/wp-content/halyard"
        },
        {
            "step": "wp-cli",
            "command": "wp eval-file /wordpress/wp-content/halyard/seed.php"
        },
        {
            "step": "wp-cli",
            "command": "wp help-center setup"
        },
        {
            "step": "wp-cli",
            "command": "wp rewrite flush"
        }
    ]
}
